        {
          "id": "SP_ASPIDOSCOPULIA_OSPREYA_DOHRMANN_G_CKE_JANUSSEN_2011",
          "name": "Aspidoscopulia ospreya Dohrmann, Göcke & Janussen, 2011",
          "rank": "SPECIES",
          "commonName": "",
