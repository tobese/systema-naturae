#!/usr/bin/env python3
"""Refuse a push to main while CI on origin's main is not green.

Decided 2026-11-02: pushes kept landing on top of a red "Verify tree
invariants" run, so a later failure could not be told from an earlier one.
This checks the verify workflow's run for the commit origin/main points at
now (the remote sha git hands this hook), via `gh`:

  success                          -> push
  queued / in progress / no run    -> refused: wait for it (gh run watch)
  failure / cancelled / timed out  -> refused: fix first

A push that is itself the fix needs a way through, or a red main could never
turn green: set SN_PUSH_OVER_RED to the reason. It is printed and appended to
.git/push-gate.log, and the run it overrode is named there.

    SN_PUSH_OVER_RED="fixes the homonym check" git push

Installed with `git config core.hooksPath scripts/hooks` (CLAUDE.md, "Git").
Only pushes to refs/heads/main are gated on CI.

Every push is also checked for file size (2026-11-02, after Asteraceae
reached 76 MB): a file the push would upload above WARN_MIB is reported, one
at or above REFUSE_MIB refuses the push -- GitHub rejects anything over 100
MiB outright, and SN_PUSH_OVER_RED does not change that. The fix for a file
that grows towards it is to split it, not Git LFS (every rewrite of a family
file would count against the LFS quota).
"""
import json
import os
import subprocess
import sys
import time

WORKFLOW = "verify.yml"
WARN_MIB = 90
REFUSE_MIB = 99
MIB = 1024 * 1024


def large_files(updates):
    """(path, bytes) for every blob the push would upload at or above
    WARN_MIB, from `git rev-list --objects` over the pushed range."""
    out = []
    for local_sha, remote_sha in updates:
        if set(local_sha) == {"0"}:
            continue                   # deleting a ref uploads nothing
        rng = [local_sha, "--not", "--remotes"] if set(remote_sha) == {"0"} else [f"{remote_sha}..{local_sha}"]
        objs = subprocess.run(["git", "rev-list", "--objects", *rng],
                              capture_output=True, text=True).stdout
        if not objs:
            continue
        sizes = subprocess.run(["git", "cat-file", "--batch-check=%(objecttype) %(objectsize) %(rest)"],
                               input=objs, capture_output=True, text=True).stdout
        for line in sizes.splitlines():
            kind, size, *rest = line.split(" ", 2)
            if kind == "blob" and int(size) >= WARN_MIB * MIB:
                out.append((rest[0] if rest else "?", int(size)))
    return sorted(set(out), key=lambda x: -x[1])


def gh_run_for(sha):
    r = subprocess.run(
        ["gh", "run", "list", "--workflow", WORKFLOW, "--branch", "main", "--limit", "20",
         "--json", "headSha,status,conclusion,databaseId,displayTitle,url"],
        capture_output=True, text=True, timeout=60)
    if r.returncode:
        raise RuntimeError(r.stderr.strip() or "gh run list failed")
    return next((x for x in json.loads(r.stdout) if x["headSha"] == sha), None)


def log(line):
    git_dir = subprocess.run(["git", "rev-parse", "--git-common-dir"],
                             capture_output=True, text=True).stdout.strip() or ".git"
    with open(os.path.join(git_dir, "push-gate.log"), "a", encoding="utf-8") as fh:
        fh.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {line}\n")


def main() -> int:
    lines = [l.split() for l in sys.stdin if l.strip()]
    big = large_files([(p[1], p[3]) for p in lines if len(p) == 4])
    for path, size in big:
        print(f"pre-push: {path} is {size / MIB:.1f} MiB "
              f"(warn at {WARN_MIB}, refuse at {REFUSE_MIB}; GitHub rejects files over 100 MiB)",
              file=sys.stderr)
    if any(size >= REFUSE_MIB * MIB for _p, size in big):
        print(f"pre-push: refused -- a file is at or above {REFUSE_MIB} MiB; split it "
              f"(SN_PUSH_OVER_RED does not apply: GitHub would reject it)", file=sys.stderr)
        return 1
    remote_shas = [p[3] for p in lines if len(p) == 4 and p[2] == "refs/heads/main"]
    if not remote_shas:
        return 0
    base = remote_shas[0]
    if set(base) == {"0"}:
        return 0                       # main does not exist on the remote yet
    override = os.environ.get("SN_PUSH_OVER_RED", "").strip()
    try:
        run = gh_run_for(base)
    except Exception as e:             # no gh, no network: fail closed
        state, detail = "unknown", f"could not ask GitHub ({e})"
    else:
        if run is None:
            state, detail = "pending", f"no {WORKFLOW} run yet for origin/main {base[:11]}"
        elif run["status"] != "completed":
            state, detail = "pending", f"run {run['databaseId']} is {run['status']}"
        else:
            state = "green" if run["conclusion"] == "success" else "red"
            detail = f"run {run['databaseId']} {run['conclusion']}: {run['displayTitle'][:60]}"
    if state == "green":
        return 0
    if override:
        print(f"pre-push: CI on origin/main is {state} ({detail}); pushing anyway: {override}",
              file=sys.stderr)
        log(f"OVERRIDE {state} {base[:11]} ({detail}): {override}")
        return 0
    print(f"pre-push: refused -- CI on origin/main is {state}: {detail}", file=sys.stderr)
    if state == "pending":
        print("  wait for it:  gh run watch", file=sys.stderr)
    else:
        print("  fix main first, or if this push is the fix:", file=sys.stderr)
        print('  SN_PUSH_OVER_RED="<why>" git push ...', file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
