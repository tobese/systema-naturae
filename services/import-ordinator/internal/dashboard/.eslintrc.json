{
	"env": {
		"browser": true,
		"es2021": true
	},
	"extends": "eslint:recommended",
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module"
	},
	"rules": {
		"no-unused-vars": "warn",
		"no-undef": "error",
		"no-unused-expressions": "warn",
		"no-console": "off",
		"no-var": "error",
		"prefer-const": "error",
		"no-var": "error",
		"prefer-arrow-functions": "warn",
		"no-debugger": "warn",
		"no-alert": "warn",
		"no-empty": "warn"
	}
}