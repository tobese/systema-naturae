{
  "name": "wikiserved",
  "version": "1.0.0",
  "private": true,
  "description": "English Wikipedia text lookup served from the Postgres wikitext mirror on debbie",
  "type": "module",
  "scripts": {
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "dev": "npm run build && node dist/server.cjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
