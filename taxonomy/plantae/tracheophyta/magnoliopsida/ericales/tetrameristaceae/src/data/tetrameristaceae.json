          "id": "SP_TETRAMERISTA_GLABRA",
          "name": "Tetramerista glabra",
          "rank": "SPECIES",
          "subspeciesCount": 0,
          "sourcedFrom": "checklistbank",
          "lineage": "Tetramerista",
          "children": [],
          "uuid": "75e950f2-bca3-54f-bd1-a03f5970ec1b67",
          "sourceIds": {
