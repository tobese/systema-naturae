          "authorityIds": "col:7Y3BB,wfo:wfo-1000023997"
        },
        {
          "id": "SP_PELLICIERA_RHIZOPHOREAE_TRIANA_PLANCH_",
          "name": "Pelliciera rhizophoreae Triana & Planch.",
          "rank": "SPECIES",
          "lineage": "Pelliciera",
          "subspeciesCount": 0,
          "description": "Pelliciera rhizophoreae Triana & Planch. — a taxonomic variant spelling of P. rhizophorae, the tea mangrove, a neotropical mangrove tree found along the Pacific coast from the Gulf of Nicoya (Costa Rica) to the Esmeraldas River (Ecuador), with small stands in Nicaragua, Panama, and Colombia on the Caribbean side. Grows up to 20 m tall with large, showy, pentamerous flowers with white to cream floral bracts, pollinated by bats (Glossophaga soricina) and hummingbirds. Produces viviparous propagules. Listed as Vulnerable on the IUCN Red List; threatened by coastal development, logging, and sea-level rise. Fossil records date to the Eocene, making it one of the oldest known mangrove lineages.",
          "sourcedFrom": "websearch",
          "authorship": "Triana & Planch.",
          "children": [],
