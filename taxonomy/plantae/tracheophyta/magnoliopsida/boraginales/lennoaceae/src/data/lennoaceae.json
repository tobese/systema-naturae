        {
          "id": "SP_PHOLISMA_ARENARIA_NUTT_EX_HOOK_",
          "name": "Pholisma arenaria Nutt. ex Hook.",
          "rank": "SPECIES",
          "lineage": "Pholisma",
          "subspeciesCount": 0,
          "description": "Correctly Pholisma arenarium, a chlorophyll-less parasitic perennial herb of the Lennoaceae (Boraginales) known as desert Christmas tree or scaly-stemmed sand plant. It forms a fleshy brownish-gray to whitish cylindrical body up to 20-30 cm tall (often partly buried in sand) that parasitizes the roots of desert shrubs. Native to southern California, Arizona and northwestern Mexico in desert, chaparral and coastal dune habitats. NatureServe: Vulnerable.",
          "sourcedFrom": "websearch",
          "authorship": "Nutt. ex Hook.",
          "children": [],
          "uuid": "a6243005-65ec-53c-837-c134bbbf361463"
        },
        {
          "id": "SP_PHOLISMA_CULIACANA_YATSK_",
          "name": "Pholisma culiacana  Yatsk.",
          "rank": "SPECIES",
          "lineage": "Pholisma",
          "subspeciesCount": 0,
          "description": "Pholisma culiacana (syn. Ammobroma culiacana) is a root-holoparasitic perennial herb in the borage family, endemic to northwestern Mexico (Sinaloa, near Culiacán). It lacks chlorophyll and obtains all nutrients from host shrubs via haustorial connections on underground roots. The plant body is a fleshy, buried stem/caudex up to 5 cm in diameter, producing short inflorescences 5–15 cm tall with tubular white flowers shaded pink. It inhabits sandy coastal and inland dunes in a very restricted range.",
          "sourcedFrom": "websearch",
          "authorship": "Yatsk.",
