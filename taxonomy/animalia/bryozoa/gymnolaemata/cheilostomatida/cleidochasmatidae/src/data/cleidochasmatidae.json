      "lineage": "Calyptooecia",
      "children": [
        {
          "id": "SP_CALYPTOOECIA_CONUMA_ALMEIDA_SOUZA_2014",
          "name": "Calyptooecia conuma Almeida & Souza, 2014",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Calyptooecia",
          "subspeciesCount": 0,
          "description": "Colony encrusting to nodular or branching. Frontal wall with rugose calcification and some small pores, lateral or proximal, but imperforate centrally. Orifice, large, rounded distally, with small condyles and a very broad and shallow sinus. Asymmetrically placed adventitious avicularia may be present. Ooecium hyperstomial, not closed by operculum and ectooecium with a membranous slit or less calcified frontal area.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:8154403",
          "authorship": "Almeida & Souza",
