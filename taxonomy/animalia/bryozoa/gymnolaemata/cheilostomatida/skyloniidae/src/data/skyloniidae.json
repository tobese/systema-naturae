        {
          "id": "SP_SKYLONIA_SANDBERGI",
          "name": "Skylonia sandbergi",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Skylonia",
          "subspeciesCount": 0,
          "description": "Colony spindle-shaped having six to nine zooids, more or less rectangular in each longitudinal row (Fig. 12 A). Length and width of a few complete spindles vary between 0.8 mm and 0.3 mm, respectively. Spindles have maximum diameter at or just below central point. Width / length ratio of median zooids varies between 0.3 mm to 0.8 mm. Width of apertures ranges from 0.05 mm to 0.07 mm. Apertures above greatest diameter of spindles open obliquely upwards. End of frontal cover depressed, forming shallow groove. Usually very well-developed knobs bordering aperture (Fig. 12 B).",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:10843364",
          "uuid": "2756e81a-8fe7-588-894-80934583f31300",
