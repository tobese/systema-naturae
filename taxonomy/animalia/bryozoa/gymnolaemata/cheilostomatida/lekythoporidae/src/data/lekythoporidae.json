    {
      "id": "GENUS_AULOPOCELLA",
      "name": "Aulopocella",
      "rank": "GENUS",
      "description": "Aulopocella — a genus of gymnolaematas.",
      "lineage": "Aulopocella",
      "children": [
        {
          "id": "SP_AULOPOCELLA_AMERICANA_VIEIRA_GORDON_SOUZA_HADDAD_2010",
          "name": "Aulopocella americana Vieira, Gordon, Souza & Haddad, 2010",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Aulopocella",
          "subspeciesCount": 0,
          "description": "Colony erect from a small attachment point of basally encrusting zooids. Small colonies unbranched, wider distally, hence narrowly claviform; large colonies (c. 30 mm high) branching outwards from the base or higher up, the branches of uneven diameter (2 – 3 mm), the longest dimension 24 mm. Zooids opening all around the axis, the main body of the zooid mostly recumbent, with the peristome angled outwards; zooids at the distal end of the colony more erect in orientation. Frontal shield smooth, with just a few very tiny areolar-septular pores in the margins and around the base of the peristome. In small fertile colonies (c. 5 mm high). Peristome elongated, tubular; at the apex of the axial (stem axis) side of the peristome is a small subtriangular avicularium with crossbar; beneath it a longitudinal ridge runs down the axial midline inside the shaft of the peristome; 1, rarely 2, other avicularia may be set in the rim of the peristome, neither associated with a descending ridge. Primary orifice deeply concealed at the bottom of the peristome, subcircular, with a broad shallow poster; condyles scarcely apparent. No oral spines.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:6487164",
          "uuid": "c31e6811-5cd0-573-bb6-d0ceab8240e742",
          "children": []
        },
