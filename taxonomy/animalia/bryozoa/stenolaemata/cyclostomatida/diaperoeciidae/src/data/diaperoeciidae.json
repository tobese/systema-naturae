        {
          "id": "SP_NEVIANIPORA_PULCHERRIMOIDEA",
          "name": "Nevianipora pulcherrimoidea",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Nevianipora",
          "subspeciesCount": 0,
          "description": "Colony erect, branching. Zooids arranged in indistinct rows. Rarely calcified pillars made by numerous kenozooids and connecting neighbouring branches develop. Gonozooid extended, slightly wider than long; ooeciopore oval, elongate and large; ooeciostome slightly curved distally, frontally or distally directed, edges extended, not directly attached to the neighbouring autozooidal tube. Dorsal side of the colony smooth and porous, with visible growth lines.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:10216018",
          "children": [],
          "uuid": "c583431e-9f7d-57e-9e2-4b24a60401978a",
          "sourceIds": {
            "col": [
              "85VZP"
            ],
            "checklistbank": "urn:lsid:marinespecies.org:taxname:1345836"
          },
          "authorityIds": "col:85VZP",
          "authorship": "(Liu in Liu, Yin & Ma, 2001)"
        },
        {
          "id": "SP_NEVIANIPORA_RUGATATA",
          "name": "Nevianipora rugatata",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Nevianipora",
          "subspeciesCount": 0,
          "description": "Colony erect, branching. Zooids arranged in indistinct rows. Branches connected by calcified pillars formed by kenozooids. Gonozooid extended; Ooeciopore circular, small, not directly attached to the neighbouring autozooidal tube. Dorsal side of the colony smooth and convex.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:10460970",
          "children": [],
          "uuid": "b5373b9a-a75f-533-83a-ccbc62b7f9f13d",
