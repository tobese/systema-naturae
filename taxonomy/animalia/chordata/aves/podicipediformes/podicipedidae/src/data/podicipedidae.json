    {
      "id": "GENUS_AECHMOPHORUS",
      "name": "Aechmophorus",
      "rank": "GENUS",
      "description": "Two large, elegant grebes of North America with long slender necks and bills, formerly considered a single species. They breed colonially on freshwater lakes and winter on the Pacific coast. Their spectacular 'rushing' courtship ceremony, in which the pair runs side-by-side across the water upright and in perfect synchrony, is one of the most famous displays in the bird world.",
      "lineage": "Large Grebes",
      "children": [
        {
          "id": "AECHMOPHORUS_OCCIDENTALIS",
          "name": "Aechmophorus occidentalis",
          "rank": "SPECIES",
          "commonName": "Western grebe",
          "lineage": "Large Grebes",
          "continents": [
            "North America"
          ],
          "subspeciesCount": 2,
          "description": "The western grebe is a species in the grebe family of water birds. Folk names include \"dabchick\", \"swan grebe\" and \"swan-necked grebe\".",
          "sourcedFrom": "wikipedia",
          "children": [],
