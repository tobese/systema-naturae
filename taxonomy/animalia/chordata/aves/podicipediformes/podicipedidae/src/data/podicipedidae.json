        {
          "id": "AECHMOPHORUS_CLARKII",
          "name": "Aechmophorus clarkii",
          "rank": "SPECIES",
          "commonName": "Clark's Grebe",
          "lineage": "Large Grebes",
          "continents": [
            "North America"
          ],
          "subspeciesCount": 0,
          "description": "Clark's grebe (Aechmophorus clarkii) is a North American waterbird species in the grebe family. Until the 1980s, it was thought to be a pale morph of the western grebe, which it resembles in size, range, and behavior. Intermediates between the two species are known.\nThis species nests on large inland lakes in western North America and migrates to the Pacific coast over the winter. It maintains local populations year-round in California, Nevada, and Arizona (the Lower Colorado River Valley), as well as in central Mexico. It feeds by diving for insects, polychaete worms, crustaceans, and salamanders.",
          "namedAfter": "John Henry Clark",
          "sourcedFrom": "wikipedia",
          "wikipediaTitle": "Clark's grebe",
          "children": [],
