    {
      "id": "GENUS_IREDIPARRA",
      "name": "Irediparra",
      "rank": "GENUS",
      "description": "A monotypic genus of the Australasian region, with a distinctive bright red fleshy comb-like wattle covering the forehead and crown. The comb-crested jacana is the only jacana found in both Australia and Southeast Asia.",
      "lineage": "Jacanas",
      "children": [
        {
          "id": "IREDIPARRA_GALLINACEA",
          "name": "Irediparra gallinacea",
          "rank": "SPECIES",
          "commonName": "Comb-crested Jacana",
          "lineage": "Jacanas",
          "continents": [
            "Australia",
            "Asia"
          ],
          "subspeciesCount": 2,
          "description": "The comb-crested jacana (Irediparra gallinacea), also known as the lotusbird or lilytrotter (though these names are sometimes used to describe Jacanidae as a whole), is the only species of jacana in the genus Irediparra. Like other jacana species, it is adapted to the floating vegetation of tropical freshwater wetlands.",
          "sourcedFrom": "wikipedia",
          "wikipediaTitle": "Comb-crested jacana",
