      "id": "GENUS_MICROPARRA",
      "name": "Microparra",
      "rank": "GENUS",
      "description": "A monotypic genus of African jacana, the smallest member of the family. The Lesser Jacana is a dainty, delicate bird with a much shorter bill and toes than other jacanas, reflecting its more terrestrial habit and preference for densely vegetated marshes.",
      "lineage": "Jacanas",
      "children": [
        {
          "id": "MICROPARRA_CAPENSIS",
          "name": "Microparra capensis",
          "rank": "SPECIES",
          "commonName": "Lesser Jacana",
          "lineage": "Jacanas",
          "continents": [
            "Africa"
          ],
          "subspeciesCount": 0,
          "description": "The lesser jacana (Microparra capensis) is a wader in the family Jacanidae and can be found in Africa.",
