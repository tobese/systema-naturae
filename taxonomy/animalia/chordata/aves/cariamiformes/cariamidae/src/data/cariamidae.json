    {
      "id": "GENUS_CARIAMA",
      "name": "Cariama",
      "rank": "GENUS",
      "description": "A monotypic genus of long-legged, terrestrial bird with a distinctive crest of upright feathers at the base of the bill. Seriemas are among the last surviving members of the Cariamiformes, an ancient bird order that also included the giant, flightless phorusrhacids or 'terror birds'. They are excellent runners and can fly short distances when necessary.",
      "lineage": "Seriemas",
      "children": [
        {
          "id": "CARIAMA_CRISTATA",
          "name": "Cariama cristata",
          "rank": "SPECIES",
          "commonName": "Red-legged seriema",
          "lineage": "Seriemas",
          "continents": [
            "South America"
          ],
          "subspeciesCount": 0,
          "description": "The red-legged seriema, also known as the crested cariama and crested seriema, is a mostly predatory terrestrial bird in the seriema family (Cariamidae), included in the Gruiformes in the old polyphyletic circumscription but recently placed in a distinct order: Cariamiformes.",
