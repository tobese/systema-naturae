    {
      "id": "GENUS_CARIAMA",
      "name": "Cariama",
      "rank": "GENUS",
      "description": "A monotypic genus of long-legged, terrestrial bird with a distinctive crest of upright feathers at the base of the bill. Seriemas are among the last surviving members of the Cariamiformes, an ancient bird order that also included the giant, flightless phorusrhacids or 'terror birds'. They are excellent runners and can fly short distances when necessary.",
      "lineage": "Seriemas",
      "children": [
