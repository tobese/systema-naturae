        {
          "id": "AEGITHALOS_GLAUCOGULARIS",
          "name": "Aegithalos glaucogularis",
          "rank": "SPECIES",
          "commonName": "Silver-throated Bushtit",
          "lineage": "Long-tailed Tits",
          "continents": [
            "Asia"
          ],
          "subspeciesCount": 2,
          "description": "The silver-throated bushtit or silver-throated tit (Aegithalos glaucogularis) is a species of passerine bird in the family Aegithalidae, widespread throughout the temperate forests of Central, East and parts of North and Western China. The bird's native habitats are mainly along the middle/lower Yangtze and Yellow River basins, although there is also a small southwestern habitat extension in Yunnan along the Lancang valley within the Hengduan Mountains. It has two recognized subspecies.",
          "sourcedFrom": "wikipedia",
          "wikipediaTitle": "Silver-throated bushtit",
