      "name": "Aramus",
      "rank": "GENUS",
      "commonName": "Limpkin",
      "description": "A monotypic genus of a long-legged, brown-streaked wading bird with a long, slightly curved bill adapted for extracting snails from their shells. The sole member of its family, it shows features intermediate between rails and cranes.",
      "children": [
        {
          "id": "ARAMUS_GUARAUNA",
          "name": "Aramus guarauna",
          "rank": "SPECIES",
          "commonName": "Limpkin",
