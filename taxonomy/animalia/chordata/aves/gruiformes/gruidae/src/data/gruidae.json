    {
      "id": "GENUS_BUGERANUS",
      "name": "Bugeranus",
      "rank": "GENUS",
      "description": "The wattled crane — a monotypic genus containing the largest crane in Africa, named for the distinctive, elongated white wattles that dangle from beneath the bill. It is restricted to the undisturbed wetlands and floodplains of Central and Southern Africa and is the most habitat-specialist of all crane species, requiring large, pristine marshes with deep water. Its bugling call is deeper and more resonant than that of any other African crane.",
      "lineage": "Steppe Cranes",
      "children": [
