        {
          "id": "COLIUS_CASTANOTUS",
          "name": "Colius castanotus",
          "rank": "SPECIES",
          "commonName": "Red-backed Mousebird",
          "lineage": "Mousebirds",
          "continents": [
            "Africa"
          ],
          "subspeciesCount": 0,
          "description": "The red-backed mousebird (Colius castanotus) is a species of bird in the Coliidae family. It is found in Angola and the Democratic Republic of the Congo. The name mousebird is based on bird's soft feathers with texture similar to a mouse's fur. The red-backed mousebird got its name from the red or chestnut color patch on its back.",
          "sourcedFrom": "wikipedia",
          "wikipediaTitle": "Red-backed mousebird",
