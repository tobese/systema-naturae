    {
      "id": "4DLP",
      "name": "Equus",
      "rank": "GENUS",
      "description": "The sole surviving genus of the family Equidae, containing all living horses, asses, and zebras — seven species that share a single hoofed toe and are found across Africa, Asia, and through domestication worldwide.",
      "children": [
        {
          "id": "6FYB7",
          "name": "Equus africanus",
          "rank": "SPECIES",
          "commonName": "African wild ass",
          "lineage": "Ass",
          "subspeciesCount": 2,
          "children": [],
          "continents": [
            "Africa"
          ],
          "description": "The African wild ass or African wild donkey, is a wild member of the horse family, Equidae. This species is thought to be the ancestor of the domestic donkey, which is sometimes placed within the same species. They live in the deserts and other arid areas of the Horn of Africa, in Eritrea, Ethiopia and Somalia.",
          "sourcedFrom": "wikipedia",
          "uuid": "d96491f4-066a-508-85c-dba8486436978c",
          "sourceIds": {
            "wikidata": [
              "Q208140"
            ],
            "itis": [
              "926142"
            ],
            "col": [
              "6FYB7"
            ]
          },
          "authorityIds": "col:6FYB7,itis:926142,wikidata:Q208140"
        },
        {
          "id": "7TKMV",
          "name": "Equus asinus",
          "rank": "SPECIES",
          "commonName": "Donkey",
          "lineage": "Ass",
          "continents": [
            "Africa"
          ],
          "subspeciesCount": 0,
          "description": "The donkey or ass is a domesticated equine. It derives from the African wild ass, Equus africanus, and may be classified either as a subspecies thereof, Equus africanus asinus, or as a separate species, Equus asinus. It was domesticated in Africa some 5000–7000 years ago, and has been used mainly as a working animal since that time.",
          "sourcedFrom": "wikipedia",
          "children": [],
          "uuid": "6766804f-e238-5aa-90f-77fa42b7f92b28",
          "sourceIds": {
            "wikidata": [
              "Q19829417"
            ],
            "col": [
              "7TKMV"
            ],
            "itis": [
              "180690"
            ],
            "checklistbank": "199739"
          },
          "authorityIds": "col:7TKMV,itis:180690,wikidata:Q19829417",
          "authorship": "Linnaeus, 1758"
        },
        {
          "id": "DOMESTIC_HORSE",
          "name": "Equus ferus caballus",
          "rank": "SPECIES",
          "commonName": "Horse",
          "lineage": "Horse",
          "continents": [
            "Asia",
            "North America"
          ],
          "children": [],
          "subspeciesCount": 0,
          "description": "The horse is a domesticated, one-toed, hoofed mammal. It belongs to the taxonomic family Equidae and is one of two extant subspecies of Equus ferus. The horse has evolved over the past 45 to 55 million years from a small multi-toed creature, Eohippus, into the large single-toed animal of today, originally in North America.",
          "sourcedFrom": "wikipedia",
          "uuid": "b9faba7c-a8c9-556-80d-a1a7ea34ff557d",
          "sourceIds": {
            "col": [
              "6FYC2"
            ],
            "itis": [
              "926143"
            ]
          },
          "authorityIds": "col:6FYC2,itis:926143"
        },
        {
          "id": "7TKN5",
          "name": "Equus grevyi",
          "rank": "SPECIES",
          "commonName": "Grévy's zebra",
          "lineage": "Zebra",
          "continents": [
            "Africa"
          ],
          "namedAfter": "Jules Grévy",
          "subspeciesCount": 0,
          "description": "Grévy's zebra, also known commonly as the imperial zebra, is the largest living species of wild equid and the most threatened of the three species of zebras, the other two being the plains zebra and the mountain zebra. Named after French president Jules Grévy, it is found in parts of Kenya and Ethiopia. Superficially, Grévy's zebra's physical features can help to identify it from the other zebra species; its overall appearance is slightly closer to that of a mule and donkey, compared to the more \"equine\" (horse) appearance of the plains and mountain zebras.",
          "sourcedFrom": "wikipedia",
          "children": [],
          "uuid": "65a57f27-12b8-5dc-bbb-c6669b98f35b6c",
          "sourceIds": {
            "wikidata": [
              "Q219565"
            ],
            "itis": [
              "202400"
            ],
