          },
          "authorityIds": "col:7TKN5,itis:202400,wikidata:Q219565",
          "authorship": "Oustalet, 1882"
        },
        {
          "id": "6FYC9",
          "name": "Equus hemionus",
          "rank": "SPECIES",
          "commonName": "Onager",
          "lineage": "Ass",
          "subspeciesCount": 4,
          "children": [],
          "continents": [
            "Asia"
          ],
          "description": "The onager, also known as hemione or Asiatic wild ass, is a species of the family Equidae native to Asia. A member of the subgenus Asinus, the onager was described and given its binomial name by German zoologist Peter Simon Pallas in 1775. Six subspecies are accepted.",
          "sourcedFrom": "wikipedia",
          "uuid": "38e53b73-e559-592-a42-ad8de3a24e0537",
          "sourceIds": {
