          "authorship": "Pallas, 1775"
        },
        {
          "id": "7TKMZ",
          "name": "Equus kiang",
          "rank": "SPECIES",
          "commonName": "Kiang",
          "lineage": "Ass",
          "subspeciesCount": 3,
          "children": [],
          "continents": [
            "Asia"
          ],
          "description": "The kiang is the largest of the Asinus subgenus. It is native to the Tibetan Plateau in Ladakh India, northern Pakistan, Tajikistan, China and northern Nepal. It inhabits montane grasslands and shrublands.",
          "sourcedFrom": "wikipedia",
