          "name": "Loxodonta cyclotis",
          "rank": "SPECIES",
          "commonName": "African Forest Elephant",
          "lineage": "African Elephants",
          "continents": [
            "Africa"
          ],
          "subspeciesCount": 0,
          "description": "The African forest elephant (Loxodonta cyclotis) is an elephant species native to humid tropical forests in West Africa and the Congo Basin.",
