          "id": "SP_TEREBRATULINA_SEPTENTRIONALIS",
          "name": "Terebratulina septentrionalis",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Terebratulina",
          "subspeciesCount": 0,
          "description": "Terebratulina septentrionalis is a species of brachiopod that comes from the family Terebratulidae.",
          "sourcedFrom": "wikipedia"
