        {
          "id": "SP_DISCRADISCA_ANTILLARUM",
          "name": "Discradisca antillarum",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Discradisca",
          "subspeciesCount": 0,
          "description": "Shell roughly dorsi-biconvex: no ventral valve was observed in the samples, the dorsal valve is subcircular in outline, with a conical profile. Apex near the third posterior part, obviously smooth while the slopes are ornamented with close growth lines crossed by tiny radial costae. Pale to brownish colour. Owing to the paucity of the material sampled during these expeditions, the internal features are not described. Depth range 67 m.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:2252390",
          "children": []
        },
