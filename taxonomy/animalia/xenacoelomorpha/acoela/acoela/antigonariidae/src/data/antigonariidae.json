    {
      "id": "GENUS_STYLOMECYNOSTOMUM",
      "name": "Stylomecynostomum",
      "rank": "GENUS",
      "description": "Stylomecynostomum — a genus in the family Antigonariidae.",
      "lineage": "Stylomecynostomum",
