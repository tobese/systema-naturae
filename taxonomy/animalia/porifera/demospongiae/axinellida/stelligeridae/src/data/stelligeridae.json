        {
          "id": "SP_PARATIMEA_OXEATA_PULITZER_FINALI_1978",
          "name": "Paratimea oxeata Pulitzer-Finali, 1978",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Paratimea",
          "subspeciesCount": 0,
          "description": "Very small (0.5 cm 2) insinuating sponge (Fig. 5 A) detected inside a cavity of a slice of a coralligenous block. Grey coloured in dry state. Skeleton. Not observed. Spicules. Macroscleres: oxeas in two size categories: I) large oxeas curved, bent or flexuous, with hastate tips (Fig. 5 B), 810 (961.25) 1200 x 15 (18) 25 μm; II) small oxeas curved or flexuous (Fig. 5 C), 300 (546.6) 700 x 2.5 (4.75) 5 μm. Microscleres: oxyasters with more or less marked centrum with 9 - 12 conical rays, 25 (41.5) 60 μm in diameter. In some cases the number of rays is reduced (Fig. 5 D).",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:2250879",
          "authorship": "Pulitzer-Finali",
          "yearPublished": "1978",
          "children": [],
