    {
      "id": "GENUS_KETOSIA",
      "name": "Ketosia",
      "rank": "GENUS",
      "description": "Ketosia — a genus of gastropodas.",
      "lineage": "Ketosia",
      "children": [
        {
          "id": "SP_KETOSIA_RIOSI_DOS_SANTOS_ABSAL_O_2006",
          "name": "Ketosia riosi Dos Santos & Absalão, 2006",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Ketosia",
          "subspeciesCount": 0,
          "description": "Shell conical, whorls slightly convex anteriorly, brown­reddish, lustrous. Protoconch paucispiral, dome­shaped. Surface with irregular pits. Teleoconch smooth with four whorls; with microscopic pits. Suture impressed. Base slightly rounded. Aperture oval, separated from teleoconch by depression. Lip thin, darker than teleoconch. Umbilicus absent. Animal unknown. Dimensions Holotype with 3.5 teleoconch whorls; length 2.2 mm. Type­material Holotype: MNRJ 10503. Paratypes 1: MNRJ 10504, [2]; paratype 2: IBUFRJ 14695 [6]; paratype 3: MORG 50446, [2]; paratype 4: MZSP 55461 [3]; paratype 5: MNHN, [2]. Paratypes 1 – 5: sta. 21 º 36 ’ 32.537 ’’ S 40 º 39 ’ 18.846 ’’ W, 30. vi. 2002, Povoação, Espírito Santo state, 10 – 30 m; paratype 6: IBUFRJ 12798: REVIZEE CENTRAL # vv 16, 21 º 10 ’ S 40 º 27 ’ W, 27 m, 26. ii. 1996, [1].",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:4361896"
        },
        {
          "id": "SP_KETOSIA_THOMEI_DOS_SANTOS_ABSAL_O_2006",
          "name": "Ketosia thomei Dos Santos & Absalão, 2006",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Ketosia",
          "subspeciesCount": 0,
          "description": "Shell conical­pupoid, whorls convex, cream to orange, opaque. Protoconch paucispiral with deep pits. Teleoconch with 3.5 whorls, smooth; with deep pits. Suture impressed. Base rounded. Aperture oval to subcircular. Lip thin, projected backwards. Chink­like umbilicus. Dimensions Holotype with 3.5 teleoconch whorls; length 2.1 mm. Type­material Holotype: MNRJ 10505. Paratype, 1: IBUFRJ 14696 GEOMAR XVI # 16 Am. 18, 22 º 24 ’ 4 S 40 º 55 ’ 0 W, 20. viii. 1980, 63 m, “ NOAC Coll. ”, [1]; paratype 2: MZSP 55460, GEOMAR XVI, # 9 Am. 11, 22 º 06 ’ 8 S 40 º 31 ’ 2 S, 20. viii. 1980, 59 m, “ NOAC Coll. ”, [1]; paratype 3: MORG 50447 GEOMAR XVI, # 17 Am. 19, 22 º 27 ’ S 40 º 58 ’ W, 20. viii. 1980, 56 m, “ NOAC Coll. ”, [2]; paratype 4: MNHN GEOMAR XVI, # 17 Am. 19, 22 º 27 ’ S 40 º 58 ’ W, 20. viii. 1980, 56 m, “ NOAC Coll. ”, [2]; IBUFRJ 7872: GEOMAR XII # 102, 21 º 38 ’, 8 S 40 º 14 ’ 5 W, 28. viii. 1979, “ NOAS Coll. ” [2]; IBUFRJ 7659: GEOMAR XII # 101, 29. viii. 1979, “ NOAS Coll. ” [4]; IBUFRJ 13808 REVIZEE # D 3, 22 º 52 ’ S 41 º 09 ’ W, 80 m, 23. ii. 1996 [1].",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:4361897"
        }
