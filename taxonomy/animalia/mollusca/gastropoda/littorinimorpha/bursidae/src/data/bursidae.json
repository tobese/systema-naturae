          "rank": "SPECIES",
          "subspeciesCount": 0,
          "sourcedFrom": "catalogue of life",
          "authorship": "Landau, Beu, Breitenberger & Dekkers, 2020",
          "children": [],
          "lineage": "Aquitanobursa"
        }
      ]
