        {
          "id": "SP_DIAPHANA_PAESSLERI",
          "name": "Diaphana paessleri",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Diaphana",
          "subspeciesCount": 0,
          "description": "Shell height to 3 mm (up to 3.3 mm according to Schiøtte 1998); ovate, delicate. Protoconch tilt, translucent in well-preserved specimens, of 1.25 markedly convex whorls. Teleoconch of up to 2 whorls, slightly convex in outline, with prominent shoulder; last whorl comprising about 85 % of total shell height. Suture deep, slightly channeled. Surface white; only sculptured with faint growth lines. Aperture elongate-ovate, interior white; columellar callus narrow, expanded over the umbilical area. Umbilicus open, narrow, delimited by a thin rim.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:5724629",
          "continents": [
