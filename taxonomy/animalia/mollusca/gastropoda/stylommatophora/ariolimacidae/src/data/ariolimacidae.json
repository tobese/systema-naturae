        {
          "id": "SP_PROPHYSAON_OBSCURUM_COCKERELL_1890",
          "name": "Prophysaon obscurum Cockerell, 1890",
          "rank": "SPECIES",
          "commonName": "Mottled taildropper",
          "lineage": "Prophysaon",
          "subspeciesCount": 0,
          "description": "<p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Helvetica;\">External: Body gray, very dark above, with or without obscure dark lateral bands on tail; mantle black; sole dark gray. typically olive colored.</p><p style=\"margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Helvetica;\">Possibly a dark color variant of <em>Prophysaon vanattae</em>.</p>.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:2294066",
          "authorship": "Cockerell",
          "yearPublished": "1890",
          "children": [],
