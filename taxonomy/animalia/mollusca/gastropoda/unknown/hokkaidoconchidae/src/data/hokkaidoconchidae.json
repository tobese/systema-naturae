        {
          "id": "SP_ABYSSOMELANIA_CAMPBELLAE_KAIM_JENKINS_TANABE_KIEL_2014",
          "name": "Abyssomelania campbellae Kaim, Jenkins, Tanabe & Kiel, 2014",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Abyssomelania",
          "subspeciesCount": 0,
          "description": "Tall shell with largest diameter of whorl slightly above the abapical suture. Shell surface smooth with opisthocline growth lines only and abyssomelanid riblets at least at last two whorls. Shell base ornamented by five broad spiral ribs intersected by growth lines with no knobs. Suture weakly incised. Protoconch, juvenile teleoconch and aperture not preserved.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:8558947",
          "authorship": "Kaim, Jenkins, Tanabe & Kiel",
          "yearPublished": "2014",
          "children": []
        },
        {
          "id": "SP_ABYSSOMELANIA_CRAMPTONI_KAIM_R_G_JENKINS_TANABE_KIEL_2014",
          "name": "Abyssomelania cramptoni Kaim, R.G.Jenkins, Tanabe & Kiel, 2014",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Abyssomelania",
          "subspeciesCount": 0,
          "description": "Tall shell with largest whorl diameter slightly above abapical suture. Protoconch unknown. Juvenile teleoconch ornamented by opisthocline axial ribs and delicate striae. Axial ribs fading out in adolescent shell, adult shell surface smooth apart from opisthocline growth lines and abyssomelanid riblets appearing at the terminal (?) teleoconch whorl. Shell base ornamented by ten spiral ribs intersected by growth lines without knobs. Suture weakly incised. Aperture poorly preserved, D-shaped.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:8511263",
          "authorship": "Kaim, R.G.Jenkins, Tanabe & Kiel",
          "yearPublished": "2014",
          "children": []
        }
      ]
