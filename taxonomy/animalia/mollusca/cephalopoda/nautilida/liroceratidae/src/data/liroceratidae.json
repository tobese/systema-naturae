        {
          "id": "SP_LIROCERAS_KARAOUII_KORN_KLUG_2023",
          "name": "Liroceras karaouii Korn & Klug, 2023",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Liroceras",
          "subspeciesCount": 0,
          "description": "Holotype PIMUZ 39515 is a corroded, desert-polished specimen with a phragmocone diameter of about 46 mm (Fig. 17). It is fully septate and has about 22 chambers in the last volution. It is, at 46 mm in conch diameter, thickly pachyconic and subinvolute (ww / dm = 0.77; uw / dm = 0.25) with a strongly depressed, reniform whorl profile (ww / wh = 1.65), a very small whorl overlap zone (IZR = 0.17) and a very high coiling rate (WER ~ 2.65). The whorl profile is crescent-shaped and widest at the subangular umbilical margin. The umbilical wall is flattened and slightly oblique. The suture line extends nearly linearly across the flanks and venter.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:12202447",
          "authorship": "Korn & Klug",
          "yearPublished": "2023",
          "children": [],
          "uuid": "8ea4220e-a9e1-590-8a9-3961b3478cafb4"
