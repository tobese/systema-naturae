        {
          "id": "SP_WOLFGANGELLA_NEILPEARTI_JAGT_M_R_COOPER_JAGT_YAZYKOVA_2022",
          "name": "Wolfgangella neilpearti Jagt, M.R.Cooper & Jagt-Yazykova, 2022",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Wolfgangella",
          "subspeciesCount": 0,
          "description": "Measurements DVL: 20 mm; APL: 22 mm. Description Shell medium in size, trapezoidal, almost as long as high (DVL / APL = 0.90) and moderately inflated. Small, anteriorly positioned umbo. Convex anterior margin passing evenly into convex ventral margin. Posterior margin obliquely truncate, posterodorsal margin almost straight. Escutcheon carina lacking; escutcheon area discriminated by slight inflexion in commarginal ribs. On flank, 14 – 15 strong, nontuberculate, commarginal ribs about as wide as interspaces. Marginal carina not prominent, but forming a line marked by strong angulosity of ribs when passing on dorso-posterior margin. Ribs tighter on dorso-posterior margin than on ventral margin.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:12174859",
          "authorship": "Jagt, M.R.Cooper & Jagt-Yazykova",
          "yearPublished": "2022",
          "children": [],
          "uuid": "19ecab3d-594e-546-aaf-d932b8e61a3ba0"
        }
      ]
    },
