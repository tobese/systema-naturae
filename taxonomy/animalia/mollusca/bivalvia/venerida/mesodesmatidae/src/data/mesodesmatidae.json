        {
          "id": "SP_PAPHIES_SUBTRIANGULATA",
          "name": "Paphies subtriangulata",
          "rank": "SPECIES",
          "commonName": "Tuatua",
          "lineage": "Paphies",
          "subspeciesCount": 0,
          "description": "Paphies subtriangulata is a species of edible bivalve clam known as tuatua in the Māori language, a member of the family Mesodesmatidae and endemic to New Zealand. It is found on all three of the main New Zealand islands, buried in fine clean sand on ocean beaches.\nThe large shell is asymmetrical, with the hinge at one side. Its closest relative, the pipi (Paphies australis), has a symmetrical shell. Due to their shell shape, and how they burrow underneath the sand, they can withstand the high-energy waves from the ocean. Using this knowledge, we can identify where they will adapt the most, and this is the energetic oceanfront.",
          "sourcedFrom": "inaturalist",
          "wikipediaTitle": "Tuatua",
          "continents": [
            "Europe"
          ],
          "children": [],
          "uuid": "45a99c56-12f9-5c7-b43-5b52dfd46ec8f7",
          "sourceIds": {
