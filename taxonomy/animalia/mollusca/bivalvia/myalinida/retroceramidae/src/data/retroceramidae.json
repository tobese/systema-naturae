        {
          "id": "SP_RETROCERAMUS_EVERESTI",
          "name": "Retroceramus everesti",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Retroceramus",
          "subspeciesCount": 0,
          "description": "Specimens small- to large-sized (H of largest specimen> 70 mm), posteroventrally elongated but of variable obliquity, umbonal area well-inflated. Hinge line straight, moderately long; anterior margin weakly convex to straight, posterior margin gently curved, ventral margin well-rounded. Umbonal area narrowly rounded in cross-section, umbo small, prosogyrate. Posterodorsal area nearly flat; angle between dorsal and anterior margin approximately 90 °. Valves ornamented with commarginal folds, asymmetric in cross-section with steeper dorsal flank. Folds regular to irregular, generally increasing in strength and distance towards ventral margin. Hinge features not seen.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:11503288",
          "uuid": "2e451635-b0c1-596-b8d-ea5e2078aac031"
        },
        {
          "id": "SP_RETROCERAMUS_GALOI",
          "name": "Retroceramus galoi",
          "rank": "SPECIES",
