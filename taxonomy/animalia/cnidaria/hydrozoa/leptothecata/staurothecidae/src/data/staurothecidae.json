            ]
          },
          "uuid": "4976f497-b8a2-566-aab-cd8168cf9a8b6a",
          "authorityIds": "checklistbank:urn:lsid:marinespecies.org:taxname:174613,col:4ZMJ5,gbif:2269377,wikidata:Q2743334",
          "authorship": "(Jäderholm, 1904)",
          "children": []
        },
