        {
          "id": "SP_STAUROTHECA_NONSCRIPTA_PE_A_CANTERO_SVOBODA_VERVOORT_1997",
          "name": "Staurotheca nonscripta Peña Cantero, Svoboda & Vervoort, 1997",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Staurotheca",
          "subspeciesCount": 0,
          "description": "Compact monosiphonic colonies consisting of a mass of stems and branches irregularly branched in several planes, up to 70 mm in diameter. With anastomoses. Hydrothecae arranged in decussate pairs, forming four longitudinal rows, immersed into the branches for approXimately one-quarter of their volume and strongly curving outwards. Adcauline hydrothecal wall with a considerable free portion (Fig. 3 B), adnate to internode for half or slightly more of its length. Free part of adcauline wall straight or slightly conveX; abcauline wall concave. Hydrothecal aperture circular; rim even and usually with numerous renovations. Gonothecae inserting at hydrothecal base. Female gonotheca urn-shaped; basal part ovoid, distally contracted into a short neck with distal aperture. Male gonotheca fusiform, with cone-shaped neck provided with a small, circular aperture.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:2268607",
          "authorship": "Peña Cantero, Svoboda & Vervoort",
          "yearPublished": "1997",
          "sourceIds": {
            "gbif": [
              "2268607"
            ],
            "col": [
              "4ZMJ4"
            ]
          },
          "uuid": "f9f8856c-5bca-55f-b26-e5e1ab61e32ec1",
          "authorityIds": "col:4ZMJ4,gbif:2268607",
          "children": []
        },
        {
          "id": "SP_STAUROTHECA_PACHYCLADA",
          "name": "Staurotheca pachyclada",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Staurotheca",
          "subspeciesCount": 0,
          "description": "Stems up to 270 mm high, sparsely branched, usually with long, roughly straight, unbranched pinnae (only occasionally with few secondary ones). Branching alternate in one plane in younger stems, but irregular in several planes in older ones. Hydrothecae arranged in decussate verticils of four to six hydrothecae, forming eight to 12 longitudinal rows; sometimes spirally arranged. Hydrothecae immersed into the branches in most of their volume; adcauline wall almost completely adnate (Fig. 11 A). In frontal view, hydrotheca typically cylindrical at distal half, but distinctly widening basally (Fig. 11 B). Hydrothecal aperture circular and sloping downwards. Hydrotheca without mushroom-shaped diaphragm (Fig. 11 A – B). Measurements (in µm). Cnidome: larger microbasic mastigophores [range 20.0 – 21.5 x 4.5 – 5.0, mean 20.8 ± 0.6 x 5.0 ± 0.2 (n = 10); ratio, range 4.0 – 4.4, mean 4.2 ± 0.1 (n = 10)]; smaller (9 x 2.5 – 3).",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:2269377",
          "sourceIds": {
            "gbif": [
              "2269377"
            ],
            "wikidata": [
              "Q2743334"
            ],
            "col": [
              "4ZMJ5"
            ],
