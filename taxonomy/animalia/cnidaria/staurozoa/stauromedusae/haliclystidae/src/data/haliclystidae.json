            ],
            "checklistbank": [
              "urn:lsid:marinespecies.org:taxname:527704"
            ],
            "checklistbank-2011": "urn:lsid:marinespecies.org:taxname:527704"
          },
          "authorityIds": "checklistbank:urn:lsid:marinespecies.org:taxname:527704,col:6L9KF,wikidata:Q5247468",
          "children": [],
          "authorship": "Kahn, Matsumoto, Hirano & Collins, 2010"
        },
