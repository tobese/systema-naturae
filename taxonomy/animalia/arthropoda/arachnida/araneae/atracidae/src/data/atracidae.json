        },
        {
          "id": "ATRAX_SUTHERLANDI",
          "name": "Atrax sutherlandi",
          "rank": "SPECIES",
          "commonName": "Southern tree funnel-web",
          "lineage": "Sydney Funnel-webs",
          "continents": [
            "Australia"
          ],
          "subspeciesCount": 0,
          "description": "Atrax sutherlandi is a species of Australian funnel-web spider found in forests on the far southern coast of New South Wales and in eastern Victoria. It was named after Struan Sutherland, whose work resulted in a successful funnel-web spider antivenom.\nNormally, A. Sutherlandi has a glossy black back and chelicerae (\"fangs\"), as well as a deep-brown or plum-coloured underbelly. An adult grows to a length of 2 inches (5 cm). A report in 2015 described an unusual individual with a blood-red belly and chelicerae. Unlike its close relative the Sydney funnel web that lives in urban areas, A. Sutherlandi commonly resides in remote areas, thus posing little danger to the public.",
          "namedAfter": "Struan Sutherland",
          "sourcedFrom": "wikipedia",
          "wikipediaTitle": "Atrax sutherlandi",
          "children": [],
          "sourceIds": {
