        {
          "id": "SP_EURYPOGON_HISAMATSUI",
          "name": "Eurypogon hisamatsui",
          "rank": "SPECIES",
          "lineage": "Eurypogon",
          "subspeciesCount": 0,
          "sourcedFrom": "gbif",
          "description": "This species can be recognized based on the following combination of characters: punctures on head and pronotum (Figs 4 D, 9 A) relatively small and deep, elytra (Fig. 4 D) together more than twice as long as wide, elytral punctures (Fig. 10 J) fine, and aedeagal median lobe relatively broad for most of its length, then gradually narrowed towards apex (Sakai 1982). Sexual dimorphism. Females are slightly more robust and relatively shorter than males, with distinctly shorter antennae. For more information, see Sakai (1982).",
          "wikipediaTitle": "gbif:1162304",
          "authorship": "Sakai, 1982",
          "children": [],
          "sourceIds": {
            "gbif": [
              "1162304"
            ],
            "itis": [
              "708635"
            ],
            "checklistbank": "1489356",
            "gbif-backbone": "1162304",
            "checklistbank-316441": "P557F",
            "checklistbank-2169": "1489356",
            "9ca92552-f23a-41a8-a140-01abaa31c931": "708635",
            "ac5f72cf-172d-4eb4-ad8c-db66ea1c78e5": "Q2943364"
