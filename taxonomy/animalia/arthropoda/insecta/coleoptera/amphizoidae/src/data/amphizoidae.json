        {
          "id": "SP_AMPHIZOA_SINICA",
          "name": "Amphizoa sinica",
          "rank": "SPECIES",
          "lineage": "Amphizoa",
          "subspeciesCount": 0,
          "sourcedFrom": "wikipedia",
          "description": "Amphizoa sinica is a species of beetle in the Amphizoidae family. The length of its body is between 11 and 13.5 millimeters. Its metasternal process is depressed, with the lateral margin raised. It lives in the northeastern province of Jilin in China and in North Korea.\nIt was first described in 1991 by Yu Peiyu and Nigel Stork.",
