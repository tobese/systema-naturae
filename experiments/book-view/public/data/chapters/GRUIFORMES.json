        {
          "id": "GENUS_GRUS",
          "name": "Grus",
          "rank": "GENUS",
          "description": "The true cranes — tall, long-legged birds of open wetlands and grasslands whose bugling calls and spectacular migration concentrations make them among the most iconic of all Palearctic birds. The common crane (trana) is Sweden's defining migratory spectacle: each April, over 100,000 cranes converge on Lake Hornborga in Västergötland to rest and refuel before continuing north to their breeding grounds, making it one of the greatest wildlife events in Europe. Cranes are among the longest-lived birds, forming pair bonds that last decades and engaging in elaborate dancing displays — leaping, wing-spreading, and bowing — that strengthen their partnership. In Sweden, the crane's resonant, bugling 'trrop trrop' call is so deeply embedded in the national consciousness that it has become synonymous with the arrival of spring.",
          "lineage": "Palearctic Cranes",
          "children": [
            {
              "id": "GRUS_GRUS",
              "name": "Grus grus",
              "rank": "SPECIES",
              "commonName": "Common crane",
              "lineage": "Palearctic Cranes",
              "continents": [
                "Europe"
              ],
              "subspeciesCount": 2,
              "description": "The common crane, also known as the Eurasian crane, is a bird of the family Gruidae, the cranes. A medium-sized species, it is the only crane commonly found in Europe besides the demoiselle crane and the Siberian crane that only are regular in the far eastern part of the continent. Along with the sandhill crane, demoiselle crane and the brolga, it is one of only four crane species not currently classified as threatened with extinction or conservation dependent on the species level.",
              "sourcedFrom": "wikipedia",
              "familySlug": "gruidae",
              "className": "aves",
              "orderName": "gruiformes",
              "extinct": false,
              "imageUrl": "https://commons.wikimedia.org/wiki/Special:FilePath/2017.07.04.-01-Wendisch%20Rietz--Kranich.jpg?width=480",
              "iucnStatus": "LC"
