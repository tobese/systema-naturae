      "id": "GENUS_FILICRISIA",
      "name": "Filicrisia",
      "rank": "GENUS",
      "description": "Filicrisia — a genus of stenolaematas.",
      "lineage": "Filicrisia",
      "children": [
        {
          "id": "SP_FILICRISIA_ALLOOECIATA_LIU_2001",
          "name": "Filicrisia allooeciata Liu, 2001",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Filicrisia",
          "subspeciesCount": 0,
          "description": "Colony erect, flexible, with internodes consisting of a single zooid. Zooid approximately 100 µm wide at the distal end, up to 230 µm at bifurcation. Apertures circular, diameter approximately 90 µm. Pseudopores scattered, slit-like, approximately 1.9 – 2.1 µm wide by 20 – 30 µm long. No gonozooids observed in the studied material.",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:1003723"
        },
        {
          "id": "SP_FILICRISIA_FRANCISCANA",
          "name": "Filicrisia franciscana",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Filicrisia",
          "subspeciesCount": 0,
          "description": "",
          "sourcedFrom": "none"
        },
        {
          "id": "SP_FILICRISIA_GENICULATA",
          "name": "Filicrisia geniculata",
          "rank": "SPECIES",
          "commonName": "",
          "lineage": "Filicrisia",
          "subspeciesCount": 0,
          "description": "<p>\"Filicrisia geniculata forms small, straggling, branched colonies which are more or less erect. The internodes normally consist of a single zooid, rarely of 2 to 3. The zooids are long slender cylinders which may be straight, sinuous or slightly angled, with a circular terminal orifice. The zooids produce branches from one or both sides. This bryozoan has no avicularia, vibracula or ovicells\"</p>",
          "sourcedFrom": "gbif",
          "wikipediaTitle": "gbif:1003722"
        },
