          "commonName": "Novocrania anomala",
          "lineage": "Novocrania",
          "subspeciesCount": 0,
          "description": "Novocrania anomala is a species of brachiopod found offshore in the eastern Atlantic Ocean.",
          "sourcedFrom": "wikipedia"
        },
        {
          "id": "SP_NOVOCRANIA_CHATHAMENSIS",
          "name": "Novocrania chathamensis",
          "rank": "SPECIES",
